# Written by scripts/setup.sh. Nothing here needs to exist before the first run.

# The database, from `bunny db create`.
BUNNY_DATABASE_URL=
BUNNY_DATABASE_AUTH_TOKEN=

# Gates POST /v1/sites, the back-office way to create a site. Generated by setup.
SMILES_SIGNUP_TOKEN=

# Email destinations: setup registers a Resend OAuth client for you, so people
# connect their own account and no API key changes hands.
RESEND_CLIENT_ID=

# The deployment's own Resend key, for magic link sign-in emails. Without it
# POST /v1/login answers 501 and the dashboard falls back to the site key and
# admin token. A destination can also use this key in place of connecting.
RESEND_API_KEY=
RESEND_FROM=

# Optional. Fill these in and the dashboard grows one-click connect buttons;
# leave them empty and people paste a webhook URL instead.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
