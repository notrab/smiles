# Written by scripts/setup.sh. Nothing here needs to exist before the first run.

# The database, from `bunny db create`.
BUNNY_DATABASE_URL=
BUNNY_DATABASE_AUTH_TOKEN=

# Gates POST /v1/sites, the back-office way to create a site. Generated by setup.
SMILES_SIGNUP_TOKEN=

# Optional. Email destinations: setup registers a Resend OAuth client for you,
# so people connect their own account and no API key changes hands. Set a key
# here instead if you would rather send from one account.
RESEND_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM=

# Optional. Fill these in and the dashboard grows one-click connect buttons;
# leave them empty and people paste a webhook URL instead.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
